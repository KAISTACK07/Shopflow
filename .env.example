# Copy to .env and fill in the two secrets below. .env is gitignored; never commit real values.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Secrets (required) -------------------------------------------------------------------------------
# Signs login tokens. At least 32 characters; the backend refuses to start with this placeholder.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Password for the demo admin created by the seed (SEED_ADMIN_EMAIL). At least 12 characters.
# Left as the placeholder, the seed skips creating an admin (products are still created).
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- PostgreSQL -------------------------------------------------------------------------------------
POSTGRES_USER=shopflow
# Use URL-safe characters: docker-compose builds DATABASE_URL for the backend container from these values.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopflow
# Host port. 5433 so it doesn't clash with a locally installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# --- Redis --------------------------------------------------------------------------------------------
REDIS_HOST_PORT=6379

# --- Ports for the app containers (docker compose up) -----------------------------------------------------
# The shop:        http://localhost:8080      API docs: http://localhost:8000/docs
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000

# --- Demo data ------------------------------------------------------------------------------------------
# true: the backend container seeds an admin + a small catalogue on start (safe to repeat). Use false in production.
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com

# --- Backend settings ----------------------------------------------------------------------------------
APP_NAME=ShopFlow API
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
# Per-user checkout rate limit (fixed window in Redis; fails open if Redis is down).
CHECKOUT_RATE_LIMIT=10
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
# Database connection pool per backend process, and how long to wait for a connection to open.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=3
REDIS_TIMEOUT_SECONDS=0.5

# --- Only when running the backend on your machine (outside Docker) ---------------------------------------
# Inside docker-compose these two are set by the compose file to reach the postgres/redis containers.
# 127.0.0.1, not localhost: on Windows 'localhost' tries ::1 first, doubling the wait when a service is down.
DATABASE_URL=postgresql+psycopg://shopflow:change-me@127.0.0.1:5433/shopflow
REDIS_URL=redis://127.0.0.1:6379/0
# The frontend dev server (npm run dev) forwards /api to http://127.0.0.1:8000. To change that, set this in your
# shell before `npm run dev` (Vite reads it from the environment, not from this file):
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
